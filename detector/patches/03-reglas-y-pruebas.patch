+            && request.resource.data.teamResponse.text.size() <= 3000
+            && request.resource.data.teamResponse.links is list
+            && request.resource.data.teamResponse.links.size() <= 8
+          );
+
+        allow delete: if isSuperadmin();
+
+        // Historial inmutable del caso
+        match /log/{lid} {
+          function theCase() {
+            return get(/databases/$(database)/documents/events/$(eid)/cases/$(cid)).data;
+          }
+
+          allow read: if isOrganizer(eid)
+            || (theCase().teamNotified == true && caseMember(theCase().projectId));
