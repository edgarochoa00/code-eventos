{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "apphosting": [
    {
      "backendId": "feria2027",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".env*",
        ".refugio",
        ".kiro",
        "*-debug.log",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "hosting": {
    "site": "feria2027",
    "public": "hosting-empty",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "feria2027",
          "region": "us-central1"
        }
      }
    ]
  }
}
