{
  "name": "code-eventos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --project demo-code --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "emulators": "npx -y firebase-tools@15 emulators:start --project demo-code --only auth,firestore",
    "dev:emulators": "NEXT_PUBLIC_USE_EMULATORS=true next dev -p 3100",
    "deploy:rules": "npx -y firebase-tools@15 deploy --only firestore:rules,firestore:indexes --project code-94fbe"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
